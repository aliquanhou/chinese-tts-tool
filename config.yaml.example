# ============================================================
# 中文 TTS 工具配置  (复制为 config.yaml 并填入你的 API 密钥)
# ============================================================
# 支持 TTS 合成 + 音色克隆，按需配置

# 默认使用的服务商: xunfei | volcano | baidu
default_provider: xunfei

# -----------------------------------------------------------
# TTS 语音合成
# -----------------------------------------------------------

# 火山引擎 (豆包语音) - 性价比最高 ¥100/百万字
volcano:
  # 从 https://console.volcengine.com/ 获取
  app_id: ""
  access_token: ""
  voice_type: "zh_female_qingxin"
  encoding: "mp3"

# 讯飞开放平台 - 免费 500次/天 (推荐新手使用)
xunfei:
  # 从 https://console.xfyun.cn/ 创建应用 -> 语音合成 获取
  app_id: ""
  api_key: ""
  api_secret: ""
  voice_name: "xiaoqian"
  speed: 50
  volume: 50

# 百度智能云 - 个人认证免费 5万次/180天
baidu:
  # 从 https://console.bce.baidu.com/ -> 语音技术 -> 创建应用 获取
  api_key: ""
  secret_key: ""
  voice_person: 0
  speed: 5
  volume: 5

# -----------------------------------------------------------
# 音色克隆 (v2)
# -----------------------------------------------------------

# 百度声音复刻 - 最快体验, 5-20秒音频即可克隆
# 定价: 创建音色 8元/个, 合成 6.5元/万字符
# baidu_clone 复用 baidu 段中的 api_key 和 secret_key

# 讯飞声音复刻 - 功能最全, 30+风格/8语种/5方言
# 定价: 按训练次数+合成字符数计费, 控制台可领免费测试量
# xunfei_clone 复用 xunfei 段中的 app_id, api_key, api_secret

# 输出设置
output:
  directory: "./output"
  format: "mp3"
